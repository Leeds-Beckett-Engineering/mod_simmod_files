  urldate = {2025-05-21},
  abstract = {In mathematics, the harmonic mean is a kind of average, one of the Pythagorean means. It is the most appropriate average for ratios and rates such as speeds, and is normally only used for positive arguments. The harmonic mean is the reciprocal of the arithmetic mean of the reciprocals of the numbers, that is, the generalized f-mean with                         f         (         x         )         =                                 1             x                                     \textbraceleft\textbackslash displaystyle f(x)=\textbraceleft\textbackslash frac \textbraceleft 1\textbraceright\textbraceleft x\textbraceright\textbraceright\textbraceright{}    . For example, the harmonic mean of 1, 4, and 4 is                                                (                                                                                     1                                            -                       1                                                           +                                        4                                            -                       1                                                           +                                        4                                            -                       1                                                                          3                                         )                                   -             1                             =                                 3                                                                1                   1                                               +                                                   1                   4                                               +                                                   1                   4                                                                          =                                 3             1.5                             =         2                  .                 \textbraceleft\textbackslash displaystyle \textbackslash left(\textbraceleft\textbackslash frac \textbraceleft 1\textasciicircum\textbraceleft -1\textbraceright +4\textasciicircum\textbraceleft -1\textbraceright +4\textasciicircum\textbraceleft -1\textbraceright\textbraceright\textbraceleft 3\textbraceright\textbraceright\textbackslash right)\textasciicircum\textbraceleft -1\textbraceright =\textbraceleft\textbackslash frac \textbraceleft 3\textbraceright\textbraceleft\textbraceleft\textbackslash frac \textbraceleft 1\textbraceright\textbraceleft 1\textbraceright\textbraceright +\textbraceleft\textbackslash frac \textbraceleft 1\textbraceright\textbraceleft 4\textbraceright\textbraceright +\textbraceleft\textbackslash frac \textbraceleft 1\textbraceright\textbraceleft 4\textbraceright\textbraceright\textbraceright\textbraceright =\textbraceleft\textbackslash frac \textbraceleft 3\textbraceright\textbraceleft 1.5\textbraceright\textbraceright =2\textbackslash,.\textbraceright},
