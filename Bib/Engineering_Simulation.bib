@incollection{MeasuresCentralTendency:2022,
  title = {Measures of {{Central Tendency}}},
  booktitle = {Statistics in {{Plain English}}},
  author = {Urdan, Timothy C.},
  year = 2022,
  edition = {Fifth},
  pages = {Chapter 2},
  publisher = {Routledge},
  url = {https://leedsbeckett.on.worldcat.org/oclc/1289390963},
  abstract = {This chapter describes the measures of central tendency that are frequently used by researchers. There are detailed descriptions of the mean, the median, and the mode. These descriptions include definitions of each of these central tendency statistics, how to calculate each one, the symbols used for each, and how these symbols differ for sample and population data. In addition, the chapter includes a discussion of how different shapes of distributions affect the mean, median, and mode. The chapter includes information about skewed distributions and how outliers can affect the shape of the distribution, the mean, and, to a lesser extent, the median. Examples of how outliers affect the shape of distributions are offered for mean and median wealth in the San Francisco Bay Area and life expectancy in several different countries.},
  isbn = {978-1-003-00645-9}
}

@incollection{MeasuresVariability:2022,
  title = {Measures of {{Variability}}},
  booktitle = {Statistics in {{Plain English}}},
  author = {Urdan, Timothy C.},
  year = 2022,
  edition = {Fifth},
  pages = {Chapter 3},
  publisher = {Routledge},
  url = {https://leedsbeckett.on.worldcat.org/oclc/1289390963},
  abstract = {This chapter describes several common measures of variability used in statistics. The three variability measures that receive the most attention are the range, variance, and standard deviation. There is a detailed discussion in this chapter as to how to calculate and interpret all three of these measures, including a consideration of the different formulas used for calculating the variance and standard deviations of sample data and population data. In addition, an exploration of the rationale for using n -- 1 in the standard deviation formula for sample data, and the effects of that adjustment with different sample sizes, is presented. The chapter also includes a discussion of the purpose of calculating variance, and of the sum-of-squared-deviations components (SS), as they are both useful in inferential statistics such as ANOVA. The chapter includes examples of these measures of variability in practice and a consideration of how to visualize variability in a distribution graphically using both histograms and boxplots.},
  isbn = {978-1-003-00645-9}
}

@article{Median:2025,
  title = {Median},
  year = 2025,
  month = may,
  journal = {Wikipedia},
  url = {https://en.wikipedia.org/w/index.php?title=Median&oldid=1291260471},
  urldate = {2025-05-21},
  abstract = {The median of a set of numbers is the value separating the higher half from the lower half of a data sample, a population, or a probability distribution. For a data set, it may be thought of as the ``middle" value. The basic feature of the median in describing data compared to the mean (often simply described as the "average") is that it is not skewed by a small proportion of extremely large or small values, and therefore provides a better representation of the center. Median income, for example, may be a better way to describe the center of the income distribution because increases in the largest incomes alone have no effect on the median. For this reason, the median is of central importance in robust statistics. Median is a 2-quantile; it is the value that partitions a set into two equal parts.},
  copyright = {Creative Commons Attribution-ShareAlike License},
  langid = {english},
  file = {/home/david/Zotero/storage/QISGIYKZ/Median.html}
}

